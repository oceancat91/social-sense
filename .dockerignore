# Docker 构建上下文 = 仓库根目录（见 deploy/docker-compose.yml 的 build.context: ..）。
# 排除体积大且运行期不用的内容，否则镜像会被 3.8 GB 权重和 525 MB GPT-2 撑爆。

.git
.gitignore
.venv
**/.venv
**/__pycache__
**/*.pyc
**/node_modules
frontend/node_modules
frontend/dist
landing/node_modules
landing/.next
landing/out

# 权重与本地素材：运行期挂载，不进镜像
social_forecast/checkpoints
social_forecast/language_model
social_forecast/results
model
tmp
.tmp-*

# 环境与密钥
.env
.env.*
**/.env
**/*.htpasswd
*.pdf
*.zip
