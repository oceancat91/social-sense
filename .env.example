# ===== 应用配置 =====
APP_NAME=social-sense
APP_ENV=development
APP_DEBUG=True
APP_PORT=5000
APP_SECRET_KEY=请替换为你的密钥

# ===== 数据库配置 =====
# DB_DRIVER=sqlite 可免装 MySQL 快速本地开发；生产环境使用 mysql
DB_DRIVER=mysql
SQLITE_PATH=social_sense.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_sense
DB_USER=root
DB_PASSWORD=请替换为你的密码

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== NLP 情感分析配置 =====
# 推荐：大模型分析（效果最好，支持反讽/隐含情绪，需联网调用 API）
# 配置 LLM_API_KEY 后自动启用大模型，未配置则回退到下方预训练模型/词典
# DeepSeek 注册并充值后创建 Key：https://platform.deepseek.com
LLM_API_KEY=
# OpenAI 兼容接口地址（DeepSeek / 通义千问 / OpenAI 均可）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次请求超时（秒）与并发线程数
LLM_TIMEOUT=30
LLM_MAX_WORKERS=8

# HuggingFace 预训练模型（无 LLM_API_KEY 且不安装 torch 或下载失败时自动降级为词典分析）
SENTIMENT_MODEL_NAME=lxyuan/distilbert-base-multilingual-cased-sentiments-student
# 国内网络受限时可尝试镜像：HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=
# 每个任务单次采集的数据量上限
CRAWL_MAX_RECORDS=600

# ===== API 密钥（按需配置） =====
# WEIBO_API_KEY=
# WEIBO_API_SECRET=
# OPENAI_API_KEY=
