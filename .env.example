# ===== 应用配置 =====
APP_NAME=social-sense
APP_ENV=development
APP_DEBUG=True
APP_PORT=5000
APP_SECRET_KEY=请替换为你的密钥

# ===== 数据库配置 =====
# DB_DRIVER=sqlite 可免装 MySQL 快速本地开发；生产环境使用 mysql
DB_DRIVER=mysql
SQLITE_PATH=social_sense.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_sense
DB_USER=root
DB_PASSWORD=请替换为你的密码

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== NLP 情感分析配置 =====
# HuggingFace 预训练模型（不安装 torch 或下载失败时自动降级为词典分析）
SENTIMENT_MODEL_NAME=lxyuan/distilbert-base-multilingual-cased-sentiments-student
# 国内网络受限时可尝试镜像：HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=
# 每个任务单次采集的数据量上限
CRAWL_MAX_RECORDS=600

# ===== API 密钥（按需配置） =====
# WEIBO_API_KEY=
# WEIBO_API_SECRET=
# OPENAI_API_KEY=
