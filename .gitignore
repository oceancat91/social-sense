# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
env/
.venv/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量
# 环境变量与密钥：真实配置一律不进版本库。
# 原先只精确匹配 .env，导致迁移产生的 .env.migrated / .env.bak-<日期> 不在忽略范围，
# 而本仓库是公开的 —— 一次 git add -A 就会把数据库密码推上去。
.env
.env.*
!.env.example
!.env.*.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 日志
logs/
*.log

# 数据库
*.sqlite3
*.db

# 多 Agent 引擎运行时产物（知识库 / 隐状态 / 报告输出）
backend/agent_outputs/
agent/KnowledgeAugmentor/store/
agent/MultimodalAnalyzer/outputs/
agent/agent/outputs/
agent/PlatformCrawler/outputs/
agent/Conclusion/outputs/

# 爬虫本地配置与原始数据（含登录凭证，严禁提交）
agent/PlatformCrawler/crawler/*.txt
agent/PlatformCrawler/crawler/*.csv
agent/PlatformCrawler/adapters/*_cookie.txt
# 外部真实数据仅本地保存；提交 manifest / reports / fusion，不提交大体积 CSV
agent/dataset/real_multiplatform/raw/

# 测试覆盖率
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# 构建产物
frontend/dist/
frontend/build/
landing/.next/
landing/out/

# Docker
docker-compose.override.yml

# 临时文件
tmp/
temp/
*.tmp

# 临时截图（本地调试产物）
.tmp-shot/

# PM2 进程配置：服务器上的实际文件常带 env 块（数据库密码、API Key 等），
# 本仓库不跟踪它。需要模板时另存为 ecosystem.config.example.js 再提交。
ecosystem.config.js
ecosystem.config.cjs
ecosystem.config.json

# --- 时序预测模型（social_forecast）---
# 真实密钥只在本地，不进版本库（示例见 social_forecast/llm_config.example.json）
social_forecast/.env
# 模型权重体积大（单个约 950 MB），由训练或 scripts/export_smoke_checkpoint.py 本地生成
social_forecast/checkpoints/*.pt
# 闭环运行产物（run_workflow.py 生成，含 LLM 调用结果）
social_forecast/results/workflow/

# --- model/ 是另一份仓库克隆（含独立 .git、3.8 GB 权重与 .env 密钥），不属于本仓库 ---
/model/
