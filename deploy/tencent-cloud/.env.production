# ===== 数据库密码（必改） =====
DB_PASSWORD=请替换为强密码

# ===== 应用密钥（必改） =====
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=请替换为随机密钥

# ===== 大模型情感分析（推荐，效果最好） =====
# 配置后情感分析自动使用大模型；未配置则回退到词典分析
LLM_API_KEY=sk-请替换为你的DeepSeekKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 管理员账户（部署后建议修改密码） =====
